{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.14.0/schemas/schema.json",
  "services": [
    {
      "product": "Face-To-Face-CRI",
      "component": "Face-To-Face-CRI Front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "checkTypes": [
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-commit.yml",
            "path": "$.jobs.pre-commit"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "unit",
            "unit test coverage",
            "accessibility",
            "integration",
            "regression",
            "visual regression"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-checks.yml",
            "path": "$.jobs.run-checks"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "unit",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-checks.yml",
            "path": "$.jobs.sonar-checks"
          }
        },
        {
          "checkTypes": [
            "code quality"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/codeql.yml",
            "path": "$.jobs.analyze"
          }
        },
        {
          "checkTypes": [
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/dependabot.yml"
          }
        }
      ]
    }
  ]
}
