{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.17.0/schemas/schema.json",
  "services": [
    {
      "product": "Face-To-Face-CRI",
      "component": "Face-To-Face-CRI Front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/pre-commit.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-checks.steps[?@.name=='Run lint']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-checks.steps[?@.name=='Run test and write coverage']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "accessibility"
            },
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-checks.steps[?@.name=='Run browser tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.sonar-checks"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/codeql.yml",
          "path": "$.jobs.analyze"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/dependabot.yml"
        }
      ]
    }
  ]
}
