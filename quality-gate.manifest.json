{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "Face-To-Face-CRI",
      "component": "Face-To-Face-CRI Front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-commit.yml",
            "path": "$.jobs.pre-commit"
          },
          "checks": [
            {
              "name": "secret scanning"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-checks.yml",
            "path": "$.jobs.run-checks.steps[?@.name=='Run lint']"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-checks.yml",
            "path": "$.jobs.run-checks.steps[?@.name=='Run test and write coverage']"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-checks.yml",
            "path": "$.jobs.run-checks.steps[?@.name=='Run browser tests']"
          },
          "checks": [
            {
              "name": "accessibility"
            },
            {
              "name": "integration"
            },
            {
              "name": "regression"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-checks.yml",
            "path": "$.jobs.sonar-checks"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/codeql.yml",
            "path": "$.jobs.analyze"
          },
          "checks": [
            {
              "name": "code quality"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/dependabot.yml"
          },
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ]
        }
      ]
    }
  ]
}
